; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters
;
; Neon Requiem — Godot 4.7, desktop 1920x1080, Yandex Games (Web) + Windows.
; Input actions mirror data/config.json "input" (InputMapHelper re-adds them if missing).

config_version=5

[application]

config/name="Neon Requiem"
config/description="Неонпанк bullet hell / roguelike: 20-минутный забег, петли, мета-прогрессия."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Signals="*res://autoload/Signals.gd"
InputMapHelper="*res://autoload/InputMapHelper.gd"
TimeService="*res://autoload/TimeService.gd"
SaveManager="*res://autoload/SaveManager.gd"
LootRoller="*res://autoload/LootRoller.gd"
DamageCalc="*res://autoload/DamageCalc.gd"
WaveDirector="*res://autoload/WaveDirector.gd"
SpawnDirector="*res://autoload/SpawnDirector.gd"
ItemSystem="*res://autoload/ItemSystem.gd"
AbilitySystem="*res://autoload/AbilitySystem.gd"
AudioBus="*res://autoload/AudioBus.gd"
MetaState="*res://autoload/MetaState.gd"
GameState="*res://autoload/GameState.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/mode.web=0

[gui]

theme/custom="res://theme/main_theme.tres"

